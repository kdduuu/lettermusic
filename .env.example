# PostgreSQL de desenvolvimento (NAO use dados de producao)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lettermusic_dev
DB_USER=lettermusic_app
DB_PASSWORD="SUA_SENHA_AQUI"

# Chave aleatoria longa para assinar tokens JWT
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES"

# Origens permitidas para o frontend local (sem barra no final)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para testes PostgreSQL reais, use variavel separada no terminal:
# LETTERMUSIC_TEST_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/lettermusic_test
# Nunca aponte testes para o banco de desenvolvimento ou producao.
